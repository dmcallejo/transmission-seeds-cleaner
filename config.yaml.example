# Transmission Seeds Cleaner configuration (used by both scripts)

# Transmission server settings
transmission:
  url: "http://localhost:9091/"
  username: "username"
  password: "password"

# Private torrents must have seeded at least this long (accumulated seeding
# time reported by Transmission) before they or their group can be removed.
seeding_time_threshold_days: 90

# Directories where torrents are stored (filter which torrents to manage).
# Only torrents downloading into these directories are considered.
torrent_directories:
  - "/path/to/torrent/storage1"
  - "/path/to/torrent/storage2"

# Library directories. A torrent whose files are hardlinked here is "in the library".
check_directories:
  - "/path/to/library/Movies"
  - "/path/to/library/TV Shows"

# Maintainerr deletion gate (maintainerr_gate.py)
maintainerr:
  url: "http://localhost:6246"
  # Map the paths Plex reports to paths on this host.
  path_mappings:
    "/mnt/storage/": "/media/"
  log_file: "maintainerr_gate.log"

# Logging (both scripts). Files rotate at midnight.
logging:
  dir: "logs"
  file: "torrent_checker.log"
  level: "DEBUG"          # DEBUG, INFO, WARNING, ERROR (written to files)
  console_level: "INFO"   # printed to stdout
  retention_days: 30
